region              = "us-east-1"
zone_id             = "Z1234567890ABCDE"
project_name        = "platform"
environment         = "prod"
route53_record_name = "app-services.example.com"

vpc_cidr        = "10.10.0.0/16"
public_subnets  = ["10.10.0.0/19", "10.10.32.0/19", "10.10.64.0/19"]
private_subnets = ["10.10.96.0/19", "10.10.128.0/19", "10.10.160.0/19"]
azs             = ["us-east-1a", "us-east-1b", "us-east-1c"]

cluster_name        = "prod-eks"
node_group_name     = "prod-nodes"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3

common_tags = {
  Project     = "Terraform-Project"
  ManagedBy   = "Terraform"
  Environment = "prod"
  Owner       = "DevOps"
}
